# Copy to .env; use unique passwords. Never commit real credentials.
AUTH_MODE=google
# Local developer sign-in: use npm run dev (no .env change needed).
# Explicit alternative: AUTH_MODE=development with NODE_ENV=development.
# Development mode requires a loopback HOST and APP_BASE_URL.
APP_BASE_URL=http://127.0.0.1:3456
HOST=127.0.0.1
PORT=3456
# OAuth client type: Web application. Authorized redirect URI:
# http://127.0.0.1:3456/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_ALLOW_ANY_GOOGLE_ACCOUNT=true
# Comma-separated verified email addresses allowed to manage shared keys.
# Blank means everyone is a regular member; keys can still be set here.
AUTH_ADMIN_EMAILS=
# Optional restrictions when AUTH_ALLOW_ANY_GOOGLE_ACCOUNT=false:
AUTH_ALLOWED_DOMAINS=
AUTH_ALLOWED_EMAILS=

# Run: docker compose up -d postgres
POSTGRES_PORT=54329
POSTGRES_PASSWORD=
OSPREY_DB_PASSWORD=
# Use OSPREY_DB_PASSWORD below (URL-encode it if needed).
DATABASE_URL=postgresql://osprey:REPLACE_WITH_APP_PASSWORD@127.0.0.1:54329/osprey
MAX_CONCURRENT_STT=8
MAX_CONCURRENT_REPLIES=8
MAX_CONCURRENT_TTS=8

# Shared provider keys. Administrators can also change these in Settings.
BW_STT_API_KEY=
DEEPGRAM_API_KEY=
TYPESAFE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
STT_PROVIDER=bandwidth
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
